---
import testi1 from '../assets/testi/1.webp';
import testi2 from '../assets/testi/testi2.webp';
import comingWhite from '../assets/testi/coming-soon-white.webp';
import comingGreen from '../assets/testi/coming-soon-green.webp';
import { WA_CHANNEL_BUKTI } from '../lib/wa';

// PRD section 9: baru ada 1 testimoni, dan isinya masih berupa bukti pengiriman.
// ponytail: kutipan dan nama SENGAJA kosong. Jangan karang kata-kata klien.
// Begitu dapat izin, isi 2 field itu dan otomatis muncul tanpa ubah layout.
// Tambah foto lain ke array ini, marquee-nya ikut memanjang sendiri.
const testimoni = [
	{
		foto: testi1,
		alt: 'Screenshot chat WhatsApp: klien minta dikabari saat pesanan siap, admin TemanKita mengabari pekerjaan sudah selesai dan bisa dicek lewat Google Drive, lalu klien berterima kasih.',
		kutipan: '',
		nama: '',
	},
	{
		foto: testi2,
		alt: 'Screenshot chat WhatsApp: bukti pembayaran DANA Rp25.000 ke Jaruu Software, lalu admin mengirim file makalah 12 halaman dan menawarkan revisi gratis 1x.',
		kutipan: '',
		nama: '',
	},
	{
		foto: comingWhite,
		alt: 'Bukti pesanan berikutnya segera hadir.',
		kutipan: '',
		nama: '',
	},
	{
		foto: comingGreen,
		alt: 'Bukti pesanan berikutnya segera hadir.',
		kutipan: '',
		nama: '',
	},
];

// Statistik disembunyikan sampai datanya nyata (PRD section 5).
const statistik: { angka: string; label: string }[] = [];

// Marquee: satu "setengah" track lalu digandakan, supaya animasi -50% nyambung tanpa jeda.
// Setengah track digemukkan dulu kalau fotonya masih sedikit, biar tidak ada ruang kosong.
const MIN_ITEM = 5;
const ulang = Math.max(1, Math.ceil(MIN_ITEM / testimoni.length));
const setengah = Array.from({ length: ulang }, () => testimoni).flat();
const track = [...setengah, ...setengah];

// Kecepatan dibuat konstan, jadi durasi ikut memanjang saat foto bertambah.
const KECEPATAN_PX_PER_DETIK = 40;
const durasi = (setengah.length * 280) / KECEPATAN_PX_PER_DETIK;
---

{
	testimoni.length > 0 && (
		<section id="testimoni" class="section bukti">
			<div class="container">
				<div class="section-head">
					<h2>Bukti pesanan yang sudah selesai</h2>
					<p>Pesanan yang sudah dikerjakan sampai selesai dan diserahkan ke klien.</p>
				</div>
			</div>

			<div class="marquee">
				<div class="track" style={`animation-duration: ${durasi}s`}>
					{
						track.map((t, i) => {
							// Salinan cuma untuk keperluan visual; screen reader cukup baca satu kali.
							const visual = i >= testimoni.length;
							return (
								<figure class="item" aria-hidden={visual ? 'true' : undefined}>
									<img
										class="foto"
										src={t.foto.src}
										width={t.foto.width}
										height={t.foto.height}
										alt={visual ? '' : t.alt}
										loading="lazy"
										decoding="async"
									/>
									{(t.kutipan || t.nama) && (
										<figcaption>
											{t.kutipan && (
												<blockquote>
													<p>{t.kutipan}</p>
												</blockquote>
											)}
											{t.nama && <span class="nama">{t.nama}</span>}
										</figcaption>
									)}
								</figure>
							);
						})
					}
				</div>
			</div>

			<div class="container aksi">
				<div class="aksi-baris">
					<a class="btn btn-primary" href={WA_CHANNEL_BUKTI} target="_blank" rel="noopener">
						Lihat semua bukti pesanan
					</a>
					{/* WCAG 2.2.2: konten bergerak otomatis harus bisa dijeda. */}
					{/* Label berubah Jeda ↔ Mainkan; tanpa aria-pressed supaya tidak dobel sinyal. */}
					<button class="btn btn-outline btn-sm jeda" type="button">Jeda animasi</button>
				</div>
				<p class="aksi-ket">Kumpulan bukti pesanan yang sudah selesai ada di channel WhatsApp kami.</p>
			</div>

			{statistik.length > 0 && (
				<div class="container">
					<ul class="stats" role="list">
						{statistik.map((s) => (
							<li>
								<strong>{s.angka}</strong>
								<span>{s.label}</span>
							</li>
						))}
					</ul>
				</div>
			)}
		</section>
	)
}

<script>
	const marquee = document.querySelector<HTMLElement>('.marquee');
	const tombolJeda = document.querySelector<HTMLButtonElement>('.jeda');

	if (marquee && tombolJeda) {
		tombolJeda.addEventListener('click', () => {
			const berhenti = marquee.classList.toggle('berhenti');
			tombolJeda.textContent = berhenti ? 'Mainkan animasi' : 'Jeda animasi';
		});

		// Hemat CPU dan baterai: animasi berhenti saat marquee di luar layar.
		new IntersectionObserver(([entry]) => {
			marquee.classList.toggle('di-luar', !entry.isIntersecting);
		}).observe(marquee);
	}
</script>

<style>
	/* Transparan supaya latar gambar halaman terlihat. */
	.bukti {
		background: transparent;
	}

	.marquee {
		overflow: hidden;
		/* Tepi kanan-kiri dilembutkan supaya foto tidak terpotong kasar. */
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 48px), transparent);
		mask-image: linear-gradient(90deg, transparent, #000 48px, #000 calc(100% - 48px), transparent);
	}

	/* Dijeda lewat tombol, atau otomatis saat marquee di luar layar. */
	.marquee.berhenti .track,
	.marquee.di-luar .track {
		animation-play-state: paused;
	}

	.aksi {
		margin-top: 40px;
	}

	.aksi-baris {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}

	.aksi-ket {
		color: var(--text-2);
		font-size: 14px;
		margin-top: 14px;
	}

	.track {
		display: flex;
		width: max-content;
		animation: geser 50s linear infinite;
	}

	/* Jarak dipasang per item, bukan pakai gap, supaya translateX(-50%) pas satu set. */
	.item {
		margin: 0 24px 0 0;
		flex-shrink: 0;
	}

	.marquee:hover .track {
		animation-play-state: paused;
	}

	@keyframes geser {
		to {
			transform: translateX(-50%);
		}
	}

	/* Tinggi sama, lebar ikut rasio masing-masing. Foto bukti rasionya
	   beda-beda (screenshot HP vs placeholder), jadi tinggi yang diseragamkan
	   supaya baris marquee rata tanpa memotong screenshot aslinya. */
	.foto {
		height: 380px;
		width: auto;
		display: block;
		border: 1px solid rgba(45, 106, 79, 0.18);
		border-radius: var(--r-panel);
		background: #fff;
	}

	figcaption {
		margin-top: 14px;
		max-width: 250px;
	}

	blockquote {
		margin: 0;
	}

	blockquote p {
		font-family: Gabarito, 'Instrument Sans', system-ui, sans-serif;
		font-size: 18px;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.02em;
		text-wrap: balance;
		margin: 0;
	}

	.nama {
		display: block;
		margin-top: 10px;
		font-weight: 600;
		font-size: 15px;
	}

	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 40px;
		list-style: none;
		margin: 40px 0 0;
		padding: 0;
	}

	.stats strong {
		display: block;
		font-family: Gabarito, 'Instrument Sans', system-ui, sans-serif;
		font-size: 34px;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.stats span {
		color: var(--text-2);
		font-size: 14px;
	}

	@media (max-width: 600px) {
		.foto {
			height: 300px;
		}
	}

	/* Tanpa animasi, salinan kedua disembunyikan dan barisnya bisa digeser manual. */
	@media (prefers-reduced-motion: reduce) {
		.marquee {
			overflow-x: auto;
		}

		/* Animasi sudah mati, tombol jeda tidak ada gunanya. */
		.jeda {
			display: none;
		}

		.item[aria-hidden='true'] {
			display: none;
		}
	}
</style>
