---
import { waLink } from '../lib/wa';
const pesan = waLink('Halo TemanKita! Aku mau pesan.');
---

<a class="wa-float" href={pesan} target="_blank" rel="noopener" aria-label="Pesan lewat WhatsApp">
	<svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
		<path
			d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.13c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.36c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.78.98-.15.16-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.16 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.11-.23-.17-.48-.29Z"
		></path>
	</svg>
</a>

<style>
	.wa-float {
		position: fixed;
		right: 18px;
		bottom: 18px;
		z-index: 40;
		display: none;
		align-items: center;
		justify-content: center;
		width: 54px;
		height: 54px;
		border-radius: 50%;
		background: var(--brand);
		color: #fff;
		box-shadow: 0 6px 20px rgba(45, 106, 79, 0.32);
	}

	.wa-float:hover {
		background: var(--brand-hover);
	}

	/* PRD: tombol mengambang hanya di mobile, muncul setelah pengguna melewati hero */
	@media (max-width: 767px) {
		.wa-float.tampil {
			display: inline-flex;
		}
	}
</style>

<script>
	const btn = document.querySelector('.wa-float') as HTMLElement;
	const hero = document.querySelector('.hero') as HTMLElement | null;
	if (btn && hero) {
		new IntersectionObserver(
			([en]) => btn.classList.toggle('tampil', !en.isIntersecting),
			{ threshold: 0 }
		).observe(hero);
	}
</script>
