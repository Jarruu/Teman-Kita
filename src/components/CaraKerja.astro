---
import { waLink } from '../lib/wa';

const langkah = [
	{ judul: 'Chat', teks: 'Ceritain tugas kamu. Gratis, cuma tanya-tanya juga boleh.' },
	{ judul: 'Kirim detail', teks: 'Kirim file, tenggat, dan referensinya. Makin lengkap, makin cepat.' },
	{ judul: 'Konfirmasi dan bayar', teks: 'Harga pasti dikasih di awal. Kamu setuju dulu, baru kami mulai.' },
	{ judul: 'Terima hasil', teks: 'Hasil dikirim sesuai tenggat. Ada yang perlu diubah? Revisi sesuai kesepakatan.' },
];

const pesan = waLink('Halo TemanKita! Aku mau pesan, ini detailnya:');
---

<section id="cara-kerja" class="section blok">
	<div class="container">
		<div class="section-head">
			<h2>Caranya cuma {langkah.length} langkah</h2>
			<p>Semuanya lewat WhatsApp. Tanpa daftar akun, tanpa isi formulir panjang.</p>
		</div>

		<ol class="steps" role="list">
			{
				langkah.map((l, i) => (
					<li class="step">
						<span class="num">{i + 1}</span>
						<h3>{l.judul}</h3>
						<p>{l.teks}</p>
					</li>
				))
			}
		</ol>

		<a class="btn btn-primary" href={pesan} target="_blank" rel="noopener"
			>Mulai dari langkah 1<span class="sr-only"> (buka WhatsApp di tab baru)</span></a
		>
	</div>
</section>

<style>
	/* Transparan supaya latar gambar halaman terlihat; garis atas-bawah
	   jadi penanda batas section. */
	.blok {
		background: transparent;
		border-block: 1px solid var(--line);
	}

	.steps {
		list-style: none;
		margin: 0 0 40px;
		padding: 0;
		display: grid;
		gap: 36px;
	}

	.step {
		display: grid;
		gap: 8px;
		padding-top: 20px;
		border-top: 2px solid var(--line);
	}

	/* Warna penanda langkah. Dibuat lebih tenang dari judul, tapi tetap
	   lolos WCAG AA di atas putih (--text-2, 5,8:1). */
	.num {
		font-family: Gabarito, 'Instrument Sans', system-ui, sans-serif;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--text-2);
	}

	.step h3 {
		font-size: 20px;
		font-weight: 700;
	}

	.step p {
		color: var(--text-2);
		font-size: 15px;
		max-width: 34rem;
	}

	@media (min-width: 900px) {
		.steps {
			grid-template-columns: repeat(4, 1fr);
			gap: 28px;
			margin-bottom: 44px;
		}

		.step {
			position: relative;
		}

		/* Chevron di celah antar kolom: menandai arah 1 → 2 → 3 → 4. */
		.step:not(:last-child)::after {
			content: '';
			position: absolute;
			top: -6px;
			left: calc(100% + 7px);
			width: 9px;
			height: 9px;
			border-top: 2px solid var(--line);
			border-right: 2px solid var(--line);
			transform: rotate(45deg);
		}
	}
</style>
