---
import { waLink } from '../lib/wa';

const faq = [
	{
		t: 'Data dan file aku aman nggak?',
		j: 'Aman. File kamu cuma dipakai untuk mengerjakan pesanan, nggak dibagikan ke siapa pun. Setelah selesai dan kamu setuju, file bisa kami hapus kalau kamu minta.',
	},
	{
		t: 'Revisi berapa kali?',
		j: 'Revisi gratis untuk perbaikan yang sesuai brief awal, sampai hasilnya pas. Kalau ada perubahan di luar brief, kami kasih tahu dulu biaya tambahannya sebelum dikerjakan.',
	},
	{
		t: 'Berapa lama pengerjaannya?',
		j: 'Tergantung jenis tugas dan tingkat kesulitannya. Estimasi per layanan ada di bagian Layanan. Butuh cepat? Bilang tenggatnya di chat, kami cek bisa atau nggak.',
	},
	{
		t: 'Bayarnya gimana?',
		j: 'Lewat transfer bank atau e-wallet. Harga pasti kami kasih di awal lewat chat, kamu setuju dulu baru kami mulai. Nggak ada biaya tersembunyi.',
	},
	{
		t: 'Kalau hasilnya nggak sesuai brief?',
		j: 'Kami kerjakan ulang sampai sesuai brief yang kamu kirim di awal. Itu bagian dari garansi kami.',
	},
	{
		t: 'Instalasi Microsoft Office itu legal?',
		j: 'Kami bantu proses instalasi di Windows 10/11 pakai Office Deployment Tool (ODT), alat resmi dari Microsoft. Untuk lisensi, kamu perlu punya lisensi resmi Microsoft sendiri. Kami nggak menyediakan atau membagikan lisensi bajakan.',
	},
	{
		t: 'Aku nggak paham harus mulai dari mana.',
		j: 'Santai. Chat aja dulu, ceritain tugasnya, gratis tanya-tanya. Kami bantu arahkan mau ambil layanan yang mana.',
	},
	{
		t: 'Bisa pesan yang nggak ada di daftar layanan?',
		j: 'Bisa banget. Kirim aja detailnya lewat WhatsApp, kami cek dulu bisa dikerjakan atau nggak.',
	},
];

const pesan = waLink('Halo TemanKita! Aku mau tanya dulu.');
---

<section id="faq" class="section container">
	<div class="faq-grid">
		<div class="faq-kiri">
			<h2>Yang sering ditanya</h2>
			<p>Masih ada yang mengganjal? Tanya langsung aja, gratis.</p>
			<a class="btn btn-outline btn-sm" href={pesan} target="_blank" rel="noopener"
				>Chat dulu, gratis tanya-tanya</a
			>
		</div>

		<div class="daftar">
			{
				faq.map((f) => (
					<details class="item">
						<summary>{f.t}</summary>
						<p>{f.j}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	/* Mobile: tumpuk dengan jarak; dua kolom baru di 880px. */
	.faq-grid {
		display: grid;
		gap: 44px;
	}

	.faq-kiri h2 {
		font-size: clamp(28px, 3.6vw, 40px);
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.faq-kiri p {
		color: var(--text-2);
		margin-top: 14px;
		max-width: 22rem;
	}

	.faq-kiri .btn {
		margin-top: 24px;
	}

	.daftar {
		border-top: 1px solid var(--line);
	}

	.item {
		border-bottom: 1px solid var(--line);
	}

	summary {
		cursor: pointer;
		padding: 20px 0;
		font-family: Gabarito, 'Instrument Sans', system-ui, sans-serif;
		font-weight: 700;
		font-size: 18px;
		list-style: none;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 20px;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::after {
		content: '+';
		color: var(--leaf);
		font-size: 24px;
		font-weight: 600;
		line-height: 1;
		flex-shrink: 0;
		transition: transform 0.15s;
	}

	details[open] summary::after {
		transform: rotate(45deg);
	}

	details[open] summary {
		padding-bottom: 6px;
	}

	.item p {
		color: var(--text-2);
		font-size: 15px;
		margin: 0;
		padding: 0 0 22px;
		max-width: 46rem;
	}

	@media (min-width: 880px) {
		.faq-grid {
			display: grid;
			grid-template-columns: 0.8fr 1.2fr;
			gap: 64px;
			align-items: start;
		}

		.faq-kiri {
			position: sticky;
			top: 100px;
			align-self: start;
		}
	}
</style>
