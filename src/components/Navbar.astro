---
import logo from '../assets/temankita-icon-nobg.png';
import { waLink } from '../lib/wa';

const pesan = waLink('Halo TemanKita! Aku mau pesan.');
const links = [
	{ href: '#hero', label: 'Home' },
	{ href: '#layanan', label: 'Layanan' },
	{ href: '#cara-kerja', label: 'Cara Kerja' },
	{ href: '#testimoni', label: 'Proof' },
	{ href: '#faq', label: 'FAQ' },
];
---

<a class="skip" href="#konten">Lewati ke konten</a>
<header class="nav">
	<div class="container nav-inner">
		<a class="logo" href="#hero" aria-label="TemanKita, kembali ke atas">
			<img src={logo.src} alt="TemanKita" fetchpriority="high" />
		</a>
		<nav aria-label="Navigasi utama">
			<ul id="nav-menu" class="links">
				{
					links.map((l) => (
						<li>
							<a class="nav-link" href={l.href}>
								{l.label}
							</a>
						</li>
					))
				}
				{/* CTA pindah ke dalam panel di mobile; versi navbar-nya disembunyikan. */}
				<li class="menu-cta">
					<a class="btn btn-primary" href={pesan} target="_blank" rel="noopener"
						>Pesan Sekarang</a
					>
				</li>
			</ul>
		</nav>
		<div class="nav-right">
			<a class="btn btn-primary btn-sm" href={pesan} target="_blank" rel="noopener"
				>Pesan Sekarang</a
			>
			<button
				class="burger"
				aria-expanded="false"
				aria-controls="nav-menu"
				aria-label="Buka menu"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector('.nav') as HTMLElement;
	const btn = header.querySelector('.burger') as HTMLButtonElement;
	const menu = document.getElementById('nav-menu') as HTMLUListElement;

	const setMenu = (open: boolean) => {
		header.classList.toggle('open', open);
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
		// Kunci scroll halaman selama menu ponsel terbuka.
		document.body.style.overflow = open ? 'hidden' : '';
	};

	btn.addEventListener('click', () => {
		setMenu(!header.classList.contains('open'));
	});

	menu.addEventListener('click', (e) => {
		if ((e.target as HTMLElement).closest('a')) setMenu(false);
	});

	// Tutup menu kalau layar dibesarkan melewati breakpoint mobile.
	// Angka harus sama dengan breakpoint CSS di atas.
	const mq = window.matchMedia('(min-width: 900px)');
	mq.addEventListener('change', (e) => {
		if (e.matches) setMenu(false);
	});

	// Hanya link anchor section (bukan CTA WhatsApp) yang ikut penanda aktif.
	const items = new Map(
		[...menu.querySelectorAll('.nav-link')].map((a) => [a.getAttribute('href')!.slice(1), a])
	);
	const obs = new IntersectionObserver(
		(entries) => {
			entries.forEach((en) => {
				if (!en.isIntersecting) return;
				items.forEach((a) => {
					a.classList.remove('active');
					a.removeAttribute('aria-current');
				});
				const a = items.get(en.target.id);
				if (a) {
					a.classList.add('active');
					a.setAttribute('aria-current', 'true');
				}
			});
		},
		{ rootMargin: '-40% 0px -55% 0px' }
	);
	items.forEach((_, id) => {
		const s = document.getElementById(id);
		if (s) obs.observe(s);
	});
</script>

<style>
	.skip {
		position: absolute;
		left: -9999px;
		top: 0;
	}

	.skip:focus {
		left: 12px;
		top: 12px;
		z-index: 100;
		background: var(--brand);
		color: #fff;
		padding: 10px 16px;
		border-radius: 8px;
		text-decoration: none;
	}

	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--paper);
		border-bottom: 1px solid var(--line);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		gap: 24px;
		height: 68px;
	}

	.logo {
		display: inline-flex;
		text-decoration: none;
	}

	.logo img {
		height: 34px;
		width: auto;
		display: block;
	}

	.nav nav {
		margin-left: auto;
	}

	.links {
		display: flex;
		gap: 28px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* .nav-link saja — CTA di dalam panel tetap bergaya tombol. */
	.nav-link {
		color: var(--text-2);
		text-decoration: none;
		font-weight: 500;
		font-size: 15px;
		padding-block: 4px;
		border-bottom: 2px solid transparent;
		transition: color 0.18s;
	}

	.nav-link:hover {
		color: var(--brand);
	}

	.nav-link.active {
		color: var(--brand);
		font-weight: 600;
		border-bottom-color: var(--brand);
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	/* CTA dalam panel hanya muncul di mobile. */
	.menu-cta {
		display: none;
	}

	.burger {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: 0;
		cursor: pointer;
		padding: 8px;
	}

	.burger span {
		width: 22px;
		height: 2px;
		border-radius: 2px;
		background: var(--brand);
	}

	@media (max-width: 899px) {
		/* .nav nav tetap margin-left:auto (dari basis) supaya grup kanan
		   (tombol + burger) terdorong ke tepi; .links-nya sendiri fixed. */

		.burger {
			display: inline-flex;
		}

		/* Menu ponsel: panel penuh, bukan dropdown tipis — target jempol
		   lebih besar dan tidak ada latar hero yang mengintip di belakang. */
		.links {
			display: none;
			position: fixed;
			inset: 68px 0 0;
			flex-direction: column;
			gap: 0;
			background: var(--paper);
			padding: 20px 24px 40px;
			overflow-y: auto;
		}

		.nav.open .links {
			display: flex;
		}

		.nav-link {
			display: block;
			padding: 16px 4px;
			padding-left: 12px;
			font-size: 17px;
			border-bottom: 0;
			border-left: 2px solid transparent;
		}

		.nav-link.active {
			border-left-color: var(--brand);
		}

		/* Logo lebih kecil + CTA navbar disembunyikan supaya bar tidak
		   meluber di 360px; CTA-nya muncul di dalam panel menu. */
		.logo img {
			height: 28px;
		}

		.nav-right .btn {
			display: none;
		}

		.menu-cta {
			display: block;
			margin-top: 24px;
			padding-left: 12px;
		}

		.menu-cta .btn {
			width: 100%;
		}
	}
</style>
