---
import heroArt from '../assets/mockup-chat-temankita.webp';
import { waLink } from '../lib/wa';
const pesan = waLink('Halo TemanKita! Aku mau tanya-tanya dulu.');
---

<section id="hero" class="hero">
	<div class="container hero-inner">
		<div class="hero-copy">
			<h1>Butuh bantuan tugas?<br />Ada TemanKita.</h1>
			<p class="sub">
				Kirim detail tugasmu lewat WhatsApp. Kami kasih harga pasti di awal, kamu setuju dulu,
				baru kami kerjakan.
			</p>
			<div class="cta">
				<a class="btn btn-primary" href={pesan} target="_blank" rel="noopener">Pesan Sekarang</a>
				<a class="btn btn-outline" href="#layanan">Lihat Layanan</a>
			</div>
			<p class="janji">Mulai dari Rp10.000, gratis tanya-tanya, dan ada garansi revisi.</p>
		</div>

		<div class="hero-art">
			<img
				class="art"
				src={heroArt.src}
				width={heroArt.width}
				height={heroArt.height}
				alt="Ilustrasi dua orang mengerjakan desain website bersama, dengan elemen berwarna hijau."
				fetchpriority="high"
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		/* Transparan supaya latar gambar halaman terlihat. */
		background: transparent;
		color: var(--brand);
		overflow: hidden;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}

	.hero-inner {
		display: grid;
		/* Satu kolom di mobile; dua kolom baru di 920px. */
		grid-template-columns: 1fr;
		gap: 52px;
		padding-block: 64px 88px;
	}

	.hero-copy {
		animation: rise 0.55s ease-out both;
	}

	.hero-copy h1 {
		/* Batas bawah 32px supaya "TemanKita." tidak pecah/melebar di 360px. */
		font-size: clamp(32px, 6vw, 62px);
		font-weight: 800;
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	.sub {
		color: var(--text-2);
		font-size: 18px;
		max-width: 30rem;
		margin-top: 22px;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 34px;
	}

	.janji {
		color: var(--text-2);
		font-size: 15px;
		margin-top: 26px;
	}

	.hero-art {
		display: flex;
		justify-content: center;
		animation: rise 0.65s 0.12s ease-out both;
	}

	.art {
		width: 100%;
		max-width: 540px;
		height: auto;
		display: block;
	}

	@media (min-width: 920px) {
		/* Setinggi layar laptop: viewport dikurangi tinggi navbar sticky. */
		.hero {
			min-height: calc(100vh - var(--nav-h));
			min-height: calc(100svh - var(--nav-h));
			display: grid;
		}

		.hero-inner {
			grid-template-columns: 1.08fr 0.92fr;
			align-items: center;
			align-content: center;
			gap: 60px;
			padding-block: 84px 104px;
		}

		/* Konten hero diperbesar supaya section terasa lebih penuh. */
		.hero-copy h1 {
			font-size: clamp(40px, 5.4vw, 76px);
		}

		.sub {
			font-size: 20px;
			max-width: 34rem;
			margin-top: 26px;
		}

		.cta {
			margin-top: 40px;
		}

		.janji {
			font-size: 16px;
			margin-top: 30px;
		}

		.art {
			max-width: 640px;
		}
	}

	@media (max-width: 640px) {
		.hero-inner {
			gap: 40px;
			padding-block: 40px 64px;
		}

		.sub {
			font-size: 17px;
		}
	}
</style>
