---
import { waLink, WA_CHANNEL, WA_CHANNEL_BUKTI, WA_NUMBER } from '../lib/wa';

const pesan = waLink('Halo TemanKita! Aku mau pesan.');
const waDisplay = `+${WA_NUMBER}`;
const tahun = new Date().getFullYear();
---

<section class="cta-akhir">
	<div class="container">
		<h2>Tugasmu kita bantu, kamu lanjut tidur.</h2>
		<p>
			Chat sekarang dan ceritain detailnya. Gratis tanya-tanya, harga pasti dikasih di awal sebelum
			kamu bayar apa pun.
		</p>
		<a class="btn btn-light" href={pesan} target="_blank" rel="noopener">Pesan Sekarang</a>
		<p class="kecil">Dibalas cepat tiap hari, jam 08.00 sampai 22.00 WIB.</p>
	</div>
</section>

<footer class="footer">
	<div class="container footer-inner">
		<div class="brand">
			<a class="nama" href="#hero">TemanKita</a>
			<p class="tagline">Bantuan tugas buat pelajar dan mahasiswa, mulai Rp10.000.</p>
		</div>
		<nav class="kolom" aria-labelledby="f-kontak">
			<h3 id="f-kontak">Kontak</h3>
			<ul role="list">
				<li>
					<a href={pesan} target="_blank" rel="noopener"
						>WhatsApp {waDisplay}<span class="sr-only"> (buka di tab baru)</span></a
					>
				</li>
				<li>
					<a href={WA_CHANNEL} target="_blank" rel="noopener"
						>Channel WhatsApp<span class="sr-only"> (buka di tab baru)</span></a
					>
				</li>
				<li>
					<a href={WA_CHANNEL_BUKTI} target="_blank" rel="noopener"
						>Testimoni WhatsApp<span class="sr-only"> (buka di tab baru)</span></a
					>
				</li>
			</ul>
		</nav>
		<nav class="kolom" aria-labelledby="f-halaman">
			<h3 id="f-halaman">Halaman</h3>
			<ul role="list">
				<li><a href="#layanan">Layanan</a></li>
				<li><a href="#cara-kerja">Cara Kerja</a></li>
				<li><a href="#faq">FAQ</a></li>
				<li><a href="/kebijakan-privasi">Kebijakan Privasi</a></li>
			</ul>
		</nav>
	</div>
	<div class="container bawah">
		<p>&copy; {tahun} TemanKita. Semua hak dilindungi.</p>
	</div>
</footer>

<style>
	.cta-akhir {
		background: var(--brand);
		color: #fff;
		padding-block: 88px;
	}

	.cta-akhir h2 {
		font-size: clamp(30px, 4.4vw, 46px);
		font-weight: 800;
		line-height: 1.06;
		letter-spacing: -0.03em;
		max-width: 20ch;
	}

	.cta-akhir p {
		color: var(--on-brand-2);
		margin-top: 18px;
		max-width: 34rem;
	}

	.cta-akhir .btn-light {
		margin-top: 30px;
	}

	/* Lebih spesifik dari .cta-akhir p, jadi tidak perlu !important. */
	.cta-akhir p.kecil {
		font-size: 13px;
		color: var(--on-brand-3);
		margin-top: 16px;
	}

	.footer {
		background: var(--brand);
		color: #fff;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		padding-top: 56px;
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr;
		gap: 40px;
	}

	.nama {
		font-family: Gabarito, 'Instrument Sans', system-ui, sans-serif;
		font-weight: 800;
		font-size: 22px;
		margin: 0;
	}

	.tagline {
		color: var(--on-brand-2);
		font-size: 15px;
		margin-top: 12px;
		max-width: 24rem;
	}

	.footer h3 {
		font-family: 'Instrument Sans', system-ui, sans-serif;
		font-size: 14px;
		font-weight: 600;
		color: var(--on-brand-3);
		margin: 0 0 14px;
	}

	.footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 10px;
	}

	.footer a {
		color: var(--on-brand-2);
		text-decoration: none;
		font-size: 15px;
	}

	.footer a:hover {
		color: #fff;
		text-decoration: underline;
	}

	/* Nama brand sebagai link: kembalikan ukuran/warna yang tertimpa .footer a. */
	.footer a.nama {
		color: #fff;
		font-size: 22px;
		text-decoration: none;
	}

	.bawah {
		margin-top: 48px;
		padding-block: 22px;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.bawah p {
		margin: 0;
		color: var(--on-brand-3);
		font-size: 13px;
	}

	@media (max-width: 700px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}

	@media (max-width: 640px) {
		.cta-akhir {
			padding-block: 64px;
		}
	}
</style>
