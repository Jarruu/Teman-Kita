---
import bg from '../assets/background.jpg';
import { WA_CHANNEL_BUKTI, WA_NUMBER } from '../lib/wa';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const JUDUL = 'TemanKita: Bantuan Tugas Mulai Rp10.000';
const DESKRIPSI =
	'TemanKita bantuin website, makalah, PPT, sampai CV, mulai Rp10.000. Gratis tanya-tanya, harga jelas di awal, chat sekarang.';

const { title = JUDUL, description = DESKRIPSI, noindex = false } = Astro.props;

// Butuh site di astro.config.mjs supaya URL-nya absolut.
const kanonik = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-temankita.png', Astro.site).href;

const skema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'TemanKita',
	url: new URL('/', Astro.site).href,
	logo: new URL('/logo.png', Astro.site).href,
	description: DESKRIPSI,
	areaServed: { '@type': 'Country', name: 'Indonesia' },
	sameAs: [WA_CHANNEL_BUKTI],
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: `+${WA_NUMBER}`,
		contactType: 'customer service',
		availableLanguage: 'id',
	},
};
---
<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={kanonik} />
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="TemanKita" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={kanonik} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="TemanKita: bantuan tugas mulai Rp10.000" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="theme-color" content="#2D6A4F" />
		<script type="application/ld+json" set:html={JSON.stringify(skema)} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Gabarito:wght@600;700;800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body style={`--page-bg: url("${bg.src}")`}>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		/* Hijau soft sebagai satu-satunya warna brand, di atas latar putih polos.
		   Hijau = ruang tempat brand ini hidup (hero, CTA, footer).
		   Putih = tempat orang membaca detailnya. */
		--brand: #2d6a4f;
		--brand-hover: #24583f;
		--leaf: #1b7f5a;
		--paper: #ffffff;
		--line: #dbeae0;
		--text-2: #4f6b5d;
		/* Teks di atas blok hijau. Ketiganya lolos WCAG AA di atas #2D6A4F. */
		--on-brand: #ffffff;
		--on-brand-2: #dbeae1;
		--on-brand-3: #cddfd5;

		/* Radius sengaja bertingkat, bukan satu radius untuk semua. */
		--r-panel: 20px;
		--r-pill: 999px;

		/* Satu sumber tinggi navbar: dipakai panel mobile, scroll-margin, dan Hero. */
		--nav-h: 68px;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		/* Cadangan kalau gambar latar gagal dimuat. */
		background: var(--paper);
	}

	html,
	body {
		margin: 0;
		padding: 0;
	}

	body {
		font-family: 'Instrument Sans', system-ui, sans-serif;
		font-size: 16px;
		line-height: 1.65;
		color: var(--brand);
		-webkit-font-smoothing: antialiased;
	}

	/* Latar gambar halaman. Dipasang sebagai lapisan fixed, bukan
	   background-attachment: fixed, supaya tetap diam saat di-scroll
	   di iOS Safari (yang mengabaikan background-attachment). */
	body::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: -1;
		background-image: var(--page-bg);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
	}

	h1,
	h2,
	h3 {
		font-family: Gabarito, 'Instrument Sans', system-ui, sans-serif;
		line-height: 1.15;
		margin: 0;
		text-wrap: balance;
	}

	p {
		margin: 0;
	}

	.container {
		width: 100%;
		max-width: 1120px;
		margin-inline: auto;
		padding-inline: 20px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 14px 26px;
		border-radius: var(--r-pill);
		font-family: 'Instrument Sans', system-ui, sans-serif;
		font-weight: 600;
		font-size: 16px;
		text-decoration: none;
		border: 1px solid transparent;
		cursor: pointer;
		transition:
			background 0.18s,
			color 0.18s,
			border-color 0.18s;
	}

	.btn-primary {
		background: var(--brand);
		color: #fff;
	}

	.btn-primary:hover {
		background: var(--brand-hover);
	}

	/* Tombol di atas blok hijau: kertas, bukan hijau di atas hijau. */
	.btn-light {
		background: #fff;
		color: var(--brand);
	}

	.btn-light:hover {
		background: var(--on-brand-2);
	}

	.btn-outline {
		background: transparent;
		color: var(--brand);
		border-color: var(--line);
	}

	.btn-outline:hover {
		border-color: var(--brand);
	}

	.btn-sm {
		padding: 10px 20px;
		font-size: 15px;
	}

	.section {
		padding-block: 88px;
	}

	section[id],
	main[id] {
		scroll-margin-top: calc(var(--nav-h) + 16px);
	}

	/* Judul section: kiri, karena seluruh halaman dibaca dari kiri. */
	.section-head {
		max-width: 44rem;
		margin-bottom: 44px;
	}

	.section-head h2 {
		font-size: clamp(28px, 3.6vw, 40px);
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.section-head p {
		color: var(--text-2);
		margin-top: 14px;
		max-width: 38rem;
	}

	:focus-visible {
		outline: 3px solid var(--leaf);
		outline-offset: 2px;
		border-radius: 4px;
	}

	/* Teks hanya untuk screen reader: terbaca, tapi tidak memakan ruang. */
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	/* Momen gerak halaman ini didefinisikan lokal di Hero.astro,
	   supaya keyframes-nya tidak keluar dari scope-nya. */

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			animation: none !important;
			transition: none !important;
		}
	}

	@media (max-width: 640px) {
		.section {
			padding-block: 64px;
		}
	}
</style>
